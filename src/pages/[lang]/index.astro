        font-weight: 700; font-size: 1.05rem;
        display: flex; align-items: center; justify-content: center;
        position: relative; z-index: 1;
      }
      .body { flex: 1; min-width: 0; }
      .body h2 { font-size: 1.2rem; margin: 0.2rem 0 0.6rem; }
