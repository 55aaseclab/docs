    <script>
      document.querySelectorAll('.tool-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.tool-btn').forEach(function (b) { b.classList.remove('active'); });
          document.querySelectorAll('.tool-panel').forEach(function (p) { p.classList.remove('active'); });
          btn.classList.add('active');
          var panel = document.getElementById('tool-' + btn.dataset.tool);
          if (panel) panel.classList.add('active');
        });
      });

      // 步骤折叠/展开 + URL 随动
      function setStepOpen(step, open) {
        step.classList.toggle('collapsed', !open);
        var toggle = step.querySelector('.step-toggle');
        if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      document.querySelectorAll('.step-toggle').forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          var step = link.closest('.step');
          var isOpen = !step.classList.contains('collapsed');
          if (isOpen) {
            setStepOpen(step, false);
            history.pushState(null, '', location.pathname + location.search);
          } else {
            setStepOpen(step, true);
            history.pushState(null, '', '#' + step.id);
          }
        });
      });

      // tabs 点击平滑滚动
      document.querySelectorAll('.tabs a[href^="#"]').forEach(function (tab) {
        tab.addEventListener('click', function (e) {
          e.preventDefault();
          var target = document.getElementById(tab.getAttribute('href').slice(1));
          if (target) target.scrollIntoView({ behavior: 'smooth' });
          document.querySelectorAll('.tabs a').forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
        });
      });

      // harness tab 切换
      document.querySelectorAll('.harness-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.harness-tab').forEach(function (b) { b.classList.remove('active'); });
          document.querySelectorAll('.harness-panel').forEach(function (p) { p.classList.remove('active'); });
          btn.classList.add('active');
          var panel = document.getElementById('harness-' + btn.dataset.harness);
          if (panel) panel.classList.add('active');
        });
      });

      // 锚点直达：#codex/#opencode/#workbuddy 切工具 tab，#register 等 → 展开对应步骤
      function activateFromHash() {
        var h = (location.hash || '').replace('#', '');
        if (!h) return;
        var tab = document.querySelector('.harness-tab[data-harness="' + h + '"]');
        if (tab) {
          var host = tab.closest('.step');
          if (host) setStepOpen(host, true);
          tab.click();
          tab.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }
        var step = document.getElementById(h);
        if (step && step.classList.contains('step')) {
          setStepOpen(step, true);
          step.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      window.addEventListener('hashchange', activateFromHash);
      if (location.hash) activateFromHash();

      // 代码块复制按钮（右上角小方块图标）
      var COPY = document.documentElement.lang === 'zh' ? '复制代码' : 'Copy code';
      function copyText(text, done) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text, done); });
        } else { fallbackCopy(text, done); }
      }
      function fallbackCopy(text, done) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        document.body.removeChild(ta);
      }
      document.querySelectorAll('main pre').forEach(function (pre) {
        var code = pre.querySelector('code');
        if (!code) return;
        var btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.type = 'button';
        btn.title = COPY;
        btn.setAttribute('aria-label', COPY);
        btn.addEventListener('click', function () {
          copyText(code.innerText.trim(), function () {
            btn.classList.add('ok');
            setTimeout(function () { btn.classList.remove('ok'); }, 1500);
          });
        });
        pre.appendChild(btn);
      });

      // os 子 tab 切换
      document.querySelectorAll('.os-tab').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var wrap = btn.closest('.harness-panel');
          wrap.querySelectorAll('.os-tab').forEach(function (b) { b.classList.remove('active'); });
          wrap.querySelectorAll('.os-panel').forEach(function (p) { p.classList.remove('active'); });
          btn.classList.add('active');
          var panel = wrap.querySelector('#os-' + btn.dataset.os);
          if (panel) panel.classList.add('active');
        });
      });
    </script>

